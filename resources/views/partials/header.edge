<header class="app-header">
  <div class="app-header-inner">

    {{-- BRAND --}}
    <a href="{{ route('home') }}" class="app-brand">
      <div class="app-brand-logo">
        AO
      </div>

      <div class="app-brand-text">
        <div class="app-brand-name">
          Agro Oasis
        </div>

        <div class="app-brand-subtitle">
          CASH MANAGEMENT
        </div>

        <div class="app-brand-tagline">
          Finance & Treasury System
        </div>
      </div>
    </a>

    {{-- RIGHT SIDE --}}
    <div class="app-header-actions">

      {{-- LIVE STATUS --}}
      <div class="header-live">
        <span class="header-live-dot"></span>

        <span id="headerClock">
          00:00:00
        </span>
      </div>

      {{-- THEME --}}
      <button
        type="button"
        id="themeToggle"
        class="header-theme-toggle"
        aria-label="Ganti tema"
      >
        <span id="themeIcon">☀️</span>
      </button>

      {{-- USER --}}
      @if(auth.user)

        <div class="header-user">

          <div class="header-user-avatar">
            {{ auth.user.initials }}
          </div>

          <div class="header-user-info">
            <div class="header-user-name">
              {{ auth.user.fullName }}
            </div>

            <div class="header-user-role">
              Cash Management
            </div>
          </div>

        </div>

        {{-- LOGOUT --}}
        @form({ route: 'session.destroy', method: 'POST' })
          <button
            type="submit"
            class="header-logout"
          >
            Keluar
          </button>
        @end

      @else

        <a
          href="{{ route('session.create') }}"
          class="header-login"
        >
          Login
        </a>

      @end

    </div>

  </div>
</header>
