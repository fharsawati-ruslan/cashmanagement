@layout()

<div class="dashboard-page">



  <main class="dashboard-content">

    <section class="dashboard-welcome">

      <div>
        <span class="dashboard-eyebrow">
          CASH MANAGEMENT
        </span>

 <h1>
  Selamat Datang,
  {{ user?.fullName || user?.email || 'User' }}
  👋
</h1>

        <p>
          Kelola arus kas Agro Oasis dengan mudah,
          terstruktur, dan terpercaya.
        </p>
      </div>

     <a
  href="/transactions/create"
  class="quick-cash-button"
>
  + Catat Transaksi
</a>

    </section>


    <section class="summary-grid">

      <article class="summary-card primary">

        <div class="summary-icon">
          💰
        </div>

        <div>
          <span>Total Saldo Kas</span>

          <strong id="cashBalance">
  Rp {{ summary.cashBalance.toLocaleString('id-ID') }}
</strong>

          <small>
            Saldo saat ini
          </small>
        </div>

      </article>


      <article class="summary-card">

        <div class="summary-icon">
          ↗️
        </div>

        <div>
          <span>Total Cash In</span>

         <strong id="totalCashIn">
  Rp {{ summary.totalCashIn.toLocaleString('id-ID') }}
</strong>

          <small>
            Belum ada transaksi
          </small>
        </div>

      </article>


      <article class="summary-card">

        <div class="summary-icon">
          ↘️
        </div>

        <div>
          <span>Total Cash Out</span>

          <strong id="totalCashOut">
  Rp {{ summary.totalCashOut.toLocaleString('id-ID') }}
</strong>

          <small>
            Belum ada transaksi
          </small>
        </div>

      </article>


      <article class="summary-card">

        <div class="summary-icon">
          🏦
        </div>

        <div>
          <span>Saldo Bank</span>

          <strong id="bankBalance">
  Rp {{ summary.bankBalance.toLocaleString('id-ID') }}
</strong>

          <small>
            Belum ada rekening
          </small>
        </div>

      </article>

    </section>


    <section class="dashboard-grid">

      <div class="dashboard-card transactions-card">

        <div class="card-heading">

          <div>
            <h2>Transaksi Terbaru</h2>

            <p>
              Riwayat Cash In dan Cash Out
            </p>
          </div>

          <a href="/transactions">
  Lihat Semua
</a>

        </div>


        <div
  class="empty-transactions"
  id="transactionsContainer"
>
  @if(summary.latestTransactions.length === 0)

    <div id="emptyTransactionState">

      <div class="empty-icon">
        💸
      </div>

      <h3>
        Belum ada transaksi
      </h3>

      <p>
        Transaksi Cash In dan Cash Out
        yang kamu catat akan muncul di sini.
      </p>

      <a
        href="{{ route('transactions.create') }}"
        class="empty-button"
      >
        Catat Cash In
      </a>

    </div>

  @else

    <div
      id="transactionList"
      class="dashboard-transaction-list"
    >

      @each(transaction in summary.latestTransactions)

        <a
          href="{{ route('transactions.show', { id: transaction.id }) }}"
          class="dashboard-transaction-item"
        >

          <div class="dashboard-transaction-icon">
            @if(transaction.type === 'cash_in')
              ↗
            @else
              ↘
            @end
          </div>

          <div class="dashboard-transaction-info">

            <strong>
              {{ transaction.transactionCode }}
            </strong>

            <small>
              {{ transaction.category }}
              •
              {{ transaction.transactionDate }}
            </small>

          </div>

          <div
            class="dashboard-transaction-amount
              {{ transaction.type === 'cash_in' ? 'income' : 'expense' }}"
          >
            {{ transaction.type === 'cash_in' ? '+' : '-' }}
            Rp {{ transaction.amount.toLocaleString('id-ID') }}
          </div>

        </a>

      @endeach

    </div>

  @end
</div>

          <h3>
            Belum ada transaksi
          </h3>

          <p>
            Transaksi Cash In dan Cash Out
            yang kamu catat akan muncul di sini.
          </p>

          <a
  href="/transactions/create?type=cash_in"
  class="empty-button"
>
  Catat Cash In
</a>

        </div>

      </div>


      <div class="dashboard-card">

        <div class="card-heading">

          <div>
            <h2>Aksi Cepat</h2>

            <p>
              Kelola transaksi keuangan
            </p>
          </div>

        </div>


        <div class="quick-actions">

          <a href="/transactions/create?type=cash_in" class="quick-action">

            <span>↗</span>

            <div>
              <strong>Cash In</strong>

              <small>
                Catat uang masuk
              </small>
            </div>

          </a>


           <a href="/transactions/create?type=cash_out" class="quick-action">

            <span>↘</span>

            <div>
              <strong>Cash Out</strong>

              <small>
                Catat uang keluar
              </small>
            </div>

          </a>


          <a href="/transactions" class="quick-action">

            <span>🧾</span>

            <div>
              <strong>Invoice</strong>

              <small>
                Upload bukti transaksi
              </small>
            </div>

          </a>


          <a href="/transactions" class="quick-action">

            <span>📊</span>

            <div>
              <strong>Laporan</strong>

              <small>
                Lihat laporan keuangan
              </small>
            </div>

          </a>

        </div>

      </div>

    </section>


    <section class="dashboard-security">

      <span>🛡️</span>

      <div>
        <strong>
          Sistem Terproteksi
        </strong>

        <p>
          Data transaksi dan informasi keuangan
          Agro Oasis dilindungi dengan sistem autentikasi.
        </p>
      </div>

    </section>

  </main>

</div>

@end
